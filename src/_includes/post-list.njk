{#- Expects `items` -#}
<div class="post-list">
    {%- for post in items %}
        {%- set pillar = post.data.pillar | pillar %}
        <article class="post-row">
            <p class="post-row-date"><time datetime="{{ post.date | isoDate }}">{{ post.date | shortDate }}</time></p>
            <div class="post-row-body">
                <h3 class="post-row-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                {% if post.data.excerpt %}<p class="post-row-excerpt">{{ post.data.excerpt | plainExcerpt }}</p>{% endif %}
                {% if pillar %}<p class="post-row-meta"><a class="pill" href="/tags/{{ pillar.slug }}/">{{ pillar.name }}</a></p>{% endif %}
            </div>
        </article>
    {%- endfor %}
</div>

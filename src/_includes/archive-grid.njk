<div class="archive-grid">
    {%- for group in collections.archiveByYear %}
        <div>
            <h3 class="archive-year">{{ group.year }}</h3>
            <ul class="archive-list">
                {%- for post in group.items %}
                    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
                {%- endfor %}
            </ul>
        </div>
    {%- endfor %}
</div>

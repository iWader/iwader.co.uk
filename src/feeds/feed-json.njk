---
permalink: feed.json
eleventyExcludeFromCollections: true
---
{#- Every value goes through `dump` (JSON.stringify) so quotes, newlines and markup in posts can't break the JSON -#}
{
    "version": "https://jsonfeed.org/version/1.1",
    "title": {{ site.name | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "home_page_url": "{{ site.productionUrl }}/",
    "feed_url": "{{ site.productionUrl }}/feed.json",
    "language": "en-GB",
    "authors": [{ "name": {{ site.name | dump | safe }}, "url": "{{ site.productionUrl }}/" }],
    "items": [
    {%- for post in collections.posts %}
        {%- set url = site.productionUrl + post.url %}
        {
            "id": {{ post.url | dump | safe }},
            "url": {{ url | dump | safe }},
            "title": {{ post.data.title | dump | safe }},
            "summary": {{ post.data.excerpt | plainExcerpt(300) | dump | safe }},
            "content_html": {{ post.templateContent | htmlToAbsoluteUrls(url) | dump | safe }},
            {%- if post.data.socialImage %}
            "image": {{ (site.productionUrl + post.data.socialImage.url) | dump | safe }},
            {%- endif %}
            "date_published": "{{ post.date | dateToRfc3339 }}"
        }{% if not loop.last %},{% endif %}
    {%- endfor %}
    ]
}

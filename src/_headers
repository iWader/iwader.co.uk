/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://gist.github.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://github.githubassets.com; img-src 'self' data: https:; frame-src https://social.lol; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  ! Access-Control-Allow-Origin

# CSS and JS are versioned with ?v= in base.njk, so it can be cached forever
/assets/iwader.css
  Cache-Control: public, max-age=31536000, immutable
/assets/highlight.css
  Cache-Control: public, max-age=31536000, immutable
/assets/theme.js
  Cache-Control: public, max-age=31536000, immutable

# Processed images are named by a hash of their content
/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800

{%- set isHome = page.url == '/' -%}
{%- set metaTitle = site.name + ' — ' + site.role if isHome else title + ' | ' + site.name -%}
{%- set metaDescription = (excerpt | plainExcerpt(160)) if excerpt else site.description -%}
{%- set canonical = site.productionUrl + page.url -%}
<!doctype html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="{{ eleventy.generator }}">
    <meta name="robots" content="{{ 'noindex, ' if noindex }}noai, noimageai">
    <meta name="color-scheme" content="light dark">

    <title>{{ metaTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <link rel="canonical" href="{{ canonical }}">

    <link rel="stylesheet" href="/assets/iwader.css?v={{ build.date.getTime() }}">
    {% if isPost %}<link rel="stylesheet" href="/assets/highlight.css?v={{ build.date.getTime() }}">{% endif %}
    <link rel="icon" href="/assets/favicon.ico" type="image/x-icon">

    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title if not isHome else metaTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:image" content="{{ site.productionUrl }}/assets/img/wade-hello.png">
    <meta name="twitter:card" content="summary">
    {% if isPost %}<meta property="article:published_time" content="{{ page.date | isoDate }}">{% endif %}
    <meta name="fediverse:creator" content="@wade@social.lol">

    <link rel="alternate" type="application/rss+xml" title="Wade Urry RSS" href="{{ site.productionUrl }}/feed.xml">
    <link rel="alternate" type="application/json" title="Wade Urry JSON Feed" href="{{ site.productionUrl }}/feed.json">
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header container">
        <a class="wordmark" href="/">Wade Urry</a>

        <nav class="site-nav" aria-label="Main">
            <a href="/blog/" {% if page.url.startsWith('/blog') or page.url.startsWith('/posts') or page.url.startsWith('/tags') %}aria-current="page"{% endif %}>Writing</a>
            <a href="/now/" {% if page.url == '/now/' %}aria-current="page"{% endif %}>Now</a>
        </nav>
    </header>

    <main id="main">
        {{ content | safe }}
    </main>

    <footer class="site-footer container">
        <p>&copy; {{ site.name }} {% year %}</p>

        <nav class="footer-links" aria-label="Elsewhere">
            <a href="{{ site.linkedin }}">LinkedIn</a>
            <a href="https://github.com/iWader">GitHub</a>
            <a rel="me" href="https://social.lol/@wade">Mastodon</a>
            <a href="https://www.strava.com/athletes/14657730">Strava</a>
            <a href="/feed.xml">RSS</a>
        </nav>
    </footer>
</body>
</html>
